#!/bin/bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

{{ if eq .chezmoi.os "darwin" -}}
{{ else if eq .chezmoi.os "linux" -}}
{{ template "download.sh" . }}
{{ template "apt.sh" . }}
# Docker Engine
if ! command -v dockerd >/dev/null 2>&1; then
    echo "Installing Docker Engine..."
    apt_install ca-certificates curl
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl "${curl_opts[@]}" -o /etc/apt/keyrings/docker.asc https://download.docker.com/linux/ubuntu/gpg
    sudo chmod a+r /etc/apt/keyrings/docker.asc
    # /etc/os-release only exists on the target machine, so shellcheck cannot follow it.
    # shellcheck source=/dev/null
    codename="$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")"
    sudo tee /etc/apt/sources.list.d/docker.sources <<EOFSRC
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: ${codename}
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOFSRC
    apt_update
    apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    sudo usermod -aG docker "$USER"
fi

# WezTerm
if ! command -v wezterm >/dev/null 2>&1; then
    echo "Installing WezTerm..."
    curl "${curl_opts[@]}" -o "$download_dir/wezterm.key" https://apt.fury.io/wez/gpg.key
    sudo gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg "$download_dir/wezterm.key"
    echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | sudo tee /etc/apt/sources.list.d/wezterm.list
    sudo chmod 644 /usr/share/keyrings/wezterm-fury.gpg
    apt_update
    apt_install wezterm
fi

# Zed
if ! command -v zed >/dev/null 2>&1; then
    echo "Installing Zed..."
    run_installer https://zed.dev/install.sh sh
fi

# Discord / Slack
sudo snap install discord
sudo snap install slack
sudo snap install vlc

# PlemolJP fonts
if ! fc-list | grep -qi "PlemolJP" >/dev/null 2>&1; then
    echo "Installing PlemolJP fonts..."
    PLEMOLJP_VER=$(curl "${curl_opts[@]}" "https://api.github.com/repos/yuru7/PlemolJP/releases/latest" | grep -o '"tag_name": "v[^"]*"' | cut -d'"' -f4 | sed 's/^v//')
    mkdir -p ~/.local/share/fonts
    for variant in PlemolJP PlemolJP_HS PlemolJP_NF; do
        curl "${curl_opts[@]}" -o "$download_dir/${variant}.zip" "https://github.com/yuru7/PlemolJP/releases/download/v${PLEMOLJP_VER}/${variant}_v${PLEMOLJP_VER}.zip"
        unzip -qo "$download_dir/${variant}.zip" -d ~/.local/share/fonts/
    done
    fc-cache -f
fi
{{ end -}}
