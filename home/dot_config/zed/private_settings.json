// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [],
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "auto_update": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  // extensions
  "auto_install_extensions": {
    "one-dark-pro": true,
    "material-icon-theme": true,
    "color-highlight": true,
    "git-firefly": true,
    "toml": true,
    "html": true,
    "lua": true,
    "astro": true,
    "dockerfile": true,
    "latex": true,
    "neocmake": true,
    "ron": true,
    "typst": true,
    "xml": true
  },
  // appearance
  "ui_font_size": 12.5,
  "ui_font_family": "PlemolJP Console NF",
  "buffer_font_size": 12.5,
  "buffer_font_family": "PlemolJP Console NF",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "icon_theme": "Material Icon Theme",
  "minimap": {
    "show": "auto"
  },
  // editor
  "format_on_save": "on",
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": null
  },
  // agent
  "agent": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager"
  },
  // languages
  "languages": {
    "Python": {
      "language_servers": ["ruff", "ty", "!pyright", "!basedpyright", "..."],
      "formatter": "language_server"
    },
    "JavaScript": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "TypeScript": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ]
    },
    "CSS": {
      "language_servers": ["tailwindcss-language-server"]
    }
  },
  "lsp": {},
  // transparency (One Dark Pro)
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
    "background": "#282c34cc",
    "editor.background": "#00000000",
    "editor.gutter.background": "#00000000",
    "editor.active_line.background": "#2c313a80",
    "panel.background": "#00000000",
    "tab_bar.background": "#00000000",
    "tab.inactive_background": "#00000000",
    "tab.active_background": "#282c3480",
    "terminal.background": "#00000000",
    "toolbar.background": "#00000000",
    "title_bar.background": "#21252baa",
    "status_bar.background": "#21252baa",
    "border": "#181a1f60",
    "border.variant": "#181a1f60",
    "elevated_surface.background": "#21252bF0",
    "surface.background": "#282c34cc",
    "scrollbar.track.background": "#3e445120",
    "scrollbar.track.border": "#00000000",
    "scrollbar.thumb.background": "#3e445140",
    "scrollbar.thumb.border": "#00000000"
  }
}
